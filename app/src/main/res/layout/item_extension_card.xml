<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="#14131A">

    <!-- Top Row: Name, Type Badge, Version -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvExtName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Extension Name"
            android:textColor="#F5F3FA"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvExtTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SKILL"
            android:textColor="#C4B5FD"
            android:background="#251B38"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvExtVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0"
            android:textColor="#AAA4B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Description -->
    <TextView
        android:id="@+id/tvExtDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Extension description and capabilities..."
        android:textColor="#AAA4B8"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Metadata: Author and Source -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvExtAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Author: Community"
            android:textColor="#777181"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvExtSource"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Source: GitHub"
            android:textColor="#777181"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Action Buttons Row 1: Enable/Disable and Inspect (100% screen bounded) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnToggleEnable"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Disable"
            android:textColor="#FFFFFF"
            android:background="#282333"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnInspect"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Inspect"
            android:textColor="#C4B5FD"
            android:background="#201D29"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </LinearLayout>

    <!-- Action Buttons Row 2: Export and Delete (100% screen bounded) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Export"
            android:textColor="#AAA4B8"
            android:background="#201D29"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnUninstall"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Delete"
            android:textColor="#F87171"
            android:background="#301518"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </LinearLayout>

</LinearLayout>
