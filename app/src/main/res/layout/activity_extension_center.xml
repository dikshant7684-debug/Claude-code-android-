<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootExtensionCenter"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#09090D">

    <!-- Top Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="#101014">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#F5F3FA"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="Extension Center"
            android:textColor="#F5F3FA"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btnCreateCustom"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="+ Create"
            android:textColor="#FFFFFF"
            android:background="#8B5CF6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>

    <!-- GitHub Quick Install Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#14131A">

        <EditText
            android:id="@+id/etInstallUrl"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="#1D1A26"
            android:hint="GitHub URL (owner/repo)"
            android:textColorHint="#8B889E"
            android:textColor="#F5F3FA"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:imeOptions="actionDone" />

        <Button
            android:id="@+id/btnInstallRepo"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:layout_marginStart="8dp"
            android:text="Install"
            android:textColor="#FFFFFF"
            android:background="#8B5CF6"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </LinearLayout>

    <!-- Status / Progress Header -->
    <TextView
        android:id="@+id/tvInstallProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#201D29"
        android:padding="8dp"
        android:textColor="#A78BFA"
        android:textSize="12sp"
        android:visibility="gone"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- Section Tabs Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#101014"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/tabContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <Button android:id="@+id/tabSkills" android:layout_width="wrap_content" android:layout_height="34dp" android:minWidth="0dp" android:text="Skills" android:textColor="#FFFFFF" android:background="#8B5CF6" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/tabAgents" android:layout_width="wrap_content" android:layout_height="34dp" android:minWidth="0dp" android:text="Agents" android:textColor="#AAA4B8" android:background="#201D29" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/tabInstalled" android:layout_width="wrap_content" android:layout_height="34dp" android:minWidth="0dp" android:text="Installed" android:textColor="#AAA4B8" android:background="#201D29" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/tabDiscover" android:layout_width="wrap_content" android:layout_height="34dp" android:minWidth="0dp" android:text="Discover" android:textColor="#AAA4B8" android:background="#201D29" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/tabCustom" android:layout_width="wrap_content" android:layout_height="34dp" android:minWidth="0dp" android:text="Custom" android:textColor="#AAA4B8" android:background="#201D29" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/tabSources" android:layout_width="wrap_content" android:layout_height="34dp" android:minWidth="0dp" android:text="Sources" android:textColor="#AAA4B8" android:background="#201D29" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/tabImportExport" android:layout_width="wrap_content" android:layout_height="34dp" android:minWidth="0dp" android:text="Import &amp; Export" android:textColor="#AAA4B8" android:background="#201D29" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/tabHistory" android:layout_width="wrap_content" android:layout_height="34dp" android:minWidth="0dp" android:text="History" android:textColor="#AAA4B8" android:background="#201D29" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="20dp"
        android:text="No extensions in this category.\nInstall from GitHub or create a custom skill."
        android:textColor="#8B889E"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Extensions List -->
    <ListView
        android:id="@+id/extensionsListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#201D29"
        android:dividerHeight="1dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay" />

</LinearLayout>
