<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090D"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnDetailBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="#F5F3FA"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Extension Details"
                android:textColor="#F5F3FA"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetailMetadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#14131A"
            android:padding="12dp"
            android:textColor="#C4B5FD"
            android:textSize="13sp"
            android:text="Metadata" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SKILL.md / System Instructions"
            android:textColor="#F5F3FA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDetailInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="10"
            android:gravity="top"
            android:background="#14131A"
            android:textColor="#F5F3FA"
            android:textSize="12sp"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnSaveInstructions"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Save Instructions"
            android:textColor="#FFFFFF"
            android:background="#8B5CF6"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
